{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title" : "Energy Consumption Rate",
  "data" : {
    "url": "https://raw.githubusercontent.com/wlow0016/FIT2179/main/Assignment_2/chart_1/data/energy_use.csv",
    "format" : {
      "type": "csv",
      "parse" : {
        "2010": "number", "2011": "number", "2012": "number", "2013": "number",
        "2014": "number", "2015": "number", "2016": "number", "2017": "number",
        "2018": "number", "2019": "number", "2020": "number", "2021": "number",
        "2022": "number", "2023": "number"
      }
   }
  },
  "transform" : [
    {
      "fold" : [
        "2010", "2011", "2012", "2013", "2014", "2015", "2016", "2017",
        "2018", "2019", "2020", "2021", "2022", "2023"
      ],
      "as" : ["Year", "Energy Use"]
    },
    {
      "filter": "isValid(datum['Energy Use'])"
    }
  ],
  "mark": {"type":"line", "point":true},
  "encoding": {
    "x": {
      "field": "Year",
      "type": "nominal",
      "title" : "Year"
    },

    "y": {
      "field": "Energy Use",
      "type": "quantitative",
      "title" : "Energy use (kg of oil equivalent per capita)"
    },
    "color" : {
      "field": "Country Name",
      "type" : "nominal", 
      "title" : "Country"
    } 
  }
}